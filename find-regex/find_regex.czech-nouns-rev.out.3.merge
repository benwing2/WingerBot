# {{label|cs|obsolete|rare}} [[forget-me-not]]
#* {{quote-book|cs|author=J. V. Kamarýt|authorlink=w:Josef Vlastimil Kamarýt|coauthors=|editor=|editors=|chapter=Hájek.|title=Sebrané světské a duchovní básně|series=|seriesvolume=|url=|archiveurl=|archivedate=|edition=|location=Praha|publisher=Ed. Grégr|year=1817|year_published=1867|isbn=|oclc=|volume=|page=94|pages=|pageurl=https://books.google.cz/books?id=DOyCuAC0q2QC&printsec=frontcover&dq=inauthor:%22Josef+Vlastimil+Kamar%C3%BDt%22&hl=cs&sa=X&ved=0ahUKEwjF6bPhlJfVAhUEiRoKHQhYCnkQ6AEINDAD#v=snippet&q=okot%C4%9B%C5%A1kou&f=false|section=|sectionurl=|passage=Jednou jen jsme / S Libinkou tam stáli, / S sedmikráskou, s '''okotěškou''' / Jako děti jsme si hráli.|translation=}}
#* {{quote-book|cs|author=Frant. Lad. Čelakovskýho|authorlink=w:František Ladislav Čelakovský|coauthors=|editor=|editors=|chapter=Vděky M. Z. Polákovi.|title=Smíšené Básně|series=|seriesvolume=|url=|archiveurl=|archivedate=|edition=|location=V Praze|publisher=|year=1822|year_published=|isbn=|oclc=|volume=|page=6|pages=|pageurl=https://books.google.cz/books?id=epxbAAAAcAAJ&pg=PT1&dq=okot%C4%9B%C5%A1ka&hl=cs&sa=X&redir_esc=y#v=onepage&q=okot%C4%9B%C5%A1ku&f=false|section=|sectionurl=|passage=u potůčku něžný / Kvíteček – první '''okotěšku''' spatřiv, / Za vděk utrhni.|translation=}}
#* {{quote-book|cs|author=Jan z Hvězdy|authorlink=w:Jan Jindřich Marek|coauthors=|editor=|editors=|chapter=Loučení.|title=Písně i jiné drobné básně|series=Zábavné spisy Jana z Hvězdy|seriesvolume=II.|url=|archiveurl=|archivedate=|edition=|location=Praha|publisher=Jar. Pospíšil|year=1823|year_published=1843|isbn=|oclc=|volume=|page=54|pages=|pageurl=https://books.google.cz/books?id=WvoVvE6kEYMC&printsec=frontcover&dq=inauthor:%22Jan+z+Hv%C4%9Bzdy%22&hl=cs&sa=X&redir_esc=y#v=onepage&q=Okot%C4%9B%C5%A1ky&f=false|section=|sectionurl=|passage=A ty malý žlutý ptáčku, / Leť tam k tomu okenečku, / Rci, že jí posílám tyto / '''Okotěšky''' do věnečku.|translation=}}
#* {{quote-book|cs|author=Jan Parobek|authorlink=|coauthors=|editor=|editors=|chapter=|title=Královna máje|series=Knihovna Kazatele|seriesvolume=čís. 1|url=|archiveurl=|archivedate=|edition=|location=Olomouc|publisher=R. Promberger|year=1888|year_published=1898|isbn=|oclc=|volume=|page=135|pages=|pageurl=http://kramerius4.nkp.cz/search/handle/uuid:a25e81e0-12a3-11e5-b9a6-5ef3fc9ae867|section=|sectionurl=|passage=Sladký jetel a '''okotěška''' (pomněnka), zvonečky a bedrník zdobí zelený ubrus.|translation=}}
#* {{quote-book|cs|author=Soňa Kolářová|authorlink=|coauthors=|editor=|editors=|chapter=|title=Analýza ukrajinských lidových názvů rostlin|series=|seriesvolume=|url=|archiveurl=|archivedate=|edition=|location=Brno|publisher=|year=2011|year_published=|isbn=|oclc=|volume=|page=69|pages=|pageurl=https://is.muni.cz/th/178883/ff_m/dp.pdf|section=|sectionurl=|passage=Pomněnka bahenní{{...}}Se somatizmem oko jsou v češtině následující názvy - ''nebeské očko, okotěšinka, '''okotěška''',''{{...}}|brackets=on|translation=}}
# {{label|cs|obsolete|rare}} [[eyebright]] {{gloss|{{taxlink|Euphrasia officinalis|species}}}}
#* {{quote-book|cs|author=Jiří Simoni|authorlink=|coauthors=|editor=|editors=|chapter=|title=Jak dosáhneme dlouhého věku ?|series=|seriesvolume=|url=|archiveurl=|archivedate=|edition=|location=Bystřice při Limbuši|publisher=J. Juriková|year=1894|year_published=|isbn=|oclc=|volume=|page=142|pages=|pageurl=http://kramerius4.nkp.cz/search/handle/uuid:01284370-5b1b-11e7-bcbf-005056827e51|section=|sectionurl=|passage='''Okotěška'''<!--wide letter spacing--> (Euphrasia off. L.), 10—15 ''cm'' vysoká rostlina s chlupatým odenkem, speřenými listy, fialovými květy. Roste na lukách, pastvištích a pasekách a t. d., kvete od července do října. Odvarem ze sušeného nebo rozetřeného listí vymývají se slabé neb choré oči, neb se v něm namáčí obkladky na ně. Pívá se také pro žaludek, pro nějž jest dobrým prostředkem.|translation=}}

