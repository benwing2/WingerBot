<ref name="Rejzek">{{R:cs:Rejzek 2015|rošáda|600}}</ref>
<ref name="CTC">[https://books.google.cz/books?id=h5ABjeEaKWMC&q=roch%C3%A1da Československý terminologický časopis], volume 5, 1966, page 184–185.</ref>
<ref name="Nase rec">{{R:cs:Nase rec|author=Vladimír Mejstřík|title=II. díl Slovníku spisovného jazyka českého ukončen|url=http://nase-rec.ujc.cas.cz/archiv.php?art=5065|year=47|volume=1964|issue=4}}</ref>
