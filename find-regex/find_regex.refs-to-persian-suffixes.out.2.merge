|3fs={{l|ajp|إلها|tr=ʔilha}}
|1p={{l|ajp|إلنا|tr=ʔilna}}
|2p={{l|ajp|إلكم|tr=ʔilkom}}
|3p={{l|ajp|إلهم|tr=ʔilhom}}
}}
