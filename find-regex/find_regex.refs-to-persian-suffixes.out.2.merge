|2ms={{l|ajp|عليك|tr=ʕalēk}}
|2fs={{l|ajp|عليك|tr=ʕalēki}}
|3ms={{l|ajp|عليه|tr=ʕalē}}
|3fs={{l|ajp|عليها|tr=ʕalēha}}
|1p={{l|ajp|علينا|tr=ʕalēna}}
|2p={{l|ajp|عليكم|tr=ʕalēkom}}
|3p={{l|ajp|عليهم|tr=ʕalēhom}}
}}

