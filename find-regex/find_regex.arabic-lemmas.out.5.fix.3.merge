{{ar-decl-noun|سِلْم|head2=سَلْم|d=سِلْم:tri|d2=سَلْم:tri|f=سِلْم|f2=سَلْم|pl=سِلْم|pl2=سَلْم|fpl=سِلْم|fpl2=سَلْم}}

