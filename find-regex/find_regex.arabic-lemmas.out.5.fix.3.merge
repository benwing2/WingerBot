#* {{quote-web|ar|work=Al-Bawwāba|url=http://www.albawabhnews.com/2757770|title=ar:"الموت يمر من هنا".. ملفات الكباري تتحول إلى مصائد للأرواح.. واتهامات متبادلة بين المهندسين والمحافظين|date=2017-10-16}}
#* {{quote-web|1=ar|work=Al-Seyassah|url=http://al-seyassah.com/%d9%83%d9%8a%d8%a8%d9%84%d8%a7%d8%aa-%d9%88%d8%b5%d9%86%d8%a7%d8%af%d9%8a%d9%82-%d8%a7%d9%84%d9%83%d9%87%d8%b1%d8%a8%d8%a7%d8%a1-%d8%a7%d9%84%d9%85%d9%83%d8%b4%d9%88%d9%81%d8%a9-%d9%85%d8%b5%d8%a7/|title=ar:كيبلات وصناديق الكهرباء المكشوفة مصائد للموت تتربص بالمارة والأطفال|date=2018-08-25|accessdate=12 September 2018|archiveurl=https://web.archive.org/web/20180912200639/http://al-seyassah.com/%D9%83%D9%8A%D8%A8%D9%84%D8%A7%D8%AA-%D9%88%D8%B5%D9%86%D8%A7%D8%AF%D9%8A%D9%82-%D8%A7%D9%84%D9%83%D9%87%D8%B1%D8%A8%D8%A7%D8%A1-%D8%A7%D9%84%D9%85%D9%83%D8%B4%D9%88%D9%81%D8%A9-%D9%85%D8%B5%D8%A7/|archivedate=12 September 2018}}

