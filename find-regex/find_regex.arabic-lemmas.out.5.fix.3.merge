* {{l|ar|ثَلَاثُونَ}}
* {{l|ar|أَرْبَعُونَ}}
* {{l|ar|خَمْسُونَ}}
* {{l|ar|سِتُّونَ}}
* {{l|ar|سَبْعُونَ}}
* {{l|ar|ثَمَانُونَ}}
* {{l|ar|تِسْعُونَ}}
{{rel-bottom}}

{{cln|ar|inflectional suffixes}}

