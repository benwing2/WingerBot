|ca=LL-Q9186-Justinrleung-鼻.wav
|c-t=bei5,bei5*
|c-t_note=bei5 - “nose”; bei5* - “nasal mucus”
|g=pit7
|h=pfs=phi;gd=pi4<!-- kch=pi3 -->
|j=bieh5
