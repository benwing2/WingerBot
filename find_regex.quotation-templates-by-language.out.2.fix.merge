{{#invoke:quote|call_template
|template  = Q
|pgn
|year=c. 100-50 BCE
|{{noitalic|Ve. 214, Funerary inscription from Corfinium}}
|refn = {{ref|name=Wallace|{{R:itc-sbl:Wallace:1984|page=90}}}}{{ref|{{R:itc:ImagIt|page=273|vol=I}}}}
|transauthor=Rex Ervin Wallace
