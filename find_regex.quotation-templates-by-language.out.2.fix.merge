{{#invoke:quote|call_template
|en
|author          = {{#if:{{{page|}}}{{{pageref|}}}{{{2|}}}
    | {{#if:{{R2A|{{{page|}}}{{{pageref|}}}{{{2|}}}|no_error=1}}
        | Richard Sympson [pseudonym]
