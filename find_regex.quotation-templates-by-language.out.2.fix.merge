|passage   = <!--
-->{{#ifeq:{{pagename}}|pes|'''}}PES{{#ifeq:{{pagename}}|pes|'''}}⸱<!--
-->{{#ifeq:{{pagename}}|pros|'''}}PROS{{#ifeq:{{pagename}}|pros|'''}}⸱<!--
-->{{#ifeq:{{pagename}}|ecuf|'''}}ECVF{{#ifeq:{{pagename}}|ecuf|'''}}⸱<!--
-->{{#ifeq:{{pagename}}|incubat|'''}}INCVBAT{{#ifeq:{{pagename}}|incubat|'''}}<br><!--
-->{{#ifeq:{{pagename}}|casnar|'''}}CASNAR{{#ifeq:{{pagename}}|casnar|'''}}⸱<!--
-->{{#ifeq:{{pagename}}|oisa|'''}}OISA{{#ifeq:{{pagename}}|oisa|'''}}⸱<!--
-->{{#ifeq:{{pagename}}|aetatu|'''}}AETATE{{#ifeq:{{pagename}}|aetatu|'''}}<br> C⸱<!--
-->{{#ifeq:{{pagename}}|Anaes|'''}}ANAES{{#ifeq:{{pagename}}|Anaes|'''}}⸱<!--
-->{{#ifeq:{{pagename}}|solois|'''}}SOLOIS{{#ifeq:{{pagename}}|solois|'''}}⸱<!--
-->{{#ifeq:{{pagename}}|des|'''}}DES{{#ifeq:{{pagename}}|des|'''}}⸱<!--
-->{{#ifeq:{{pagename}}|forte|'''}}FORTE{{#ifeq:{{pagename}}|forte|'''}}<br> <!--
-->{{#ifeq:{{pagename}}|faber|'''}}FABER{{#ifeq:{{pagename}}|faber|'''}}<!--
-->
|t         = <!--
-->A {{#ifeq:{{pagename}}|pes|'''}}pious{{#ifeq:{{pagename}}|pes|'''}} and <!--
-->{{#ifeq:{{pagename}}|pros|'''}}upright{{#ifeq:{{pagename}}|pros|'''}} man, <!--
-->C. {{#ifeq:{{pagename}}|Anaes|'''}}Anaeus{{#ifeq:{{pagename}}|Anaes|'''}} <!--
-->{{#ifeq:{{pagename}}|incubat|'''}}lies{{#ifeq:{{pagename}}|incubat|'''}} <!--
-->{{#ifeq:{{pagename}}|ecuf|'''}}here{{#ifeq:{{pagename}}|ecuf|'''}}, an <!--
-->{{#ifeq:{{pagename}}|casnar|'''}}old man{{#ifeq:{{pagename}}|casnar|'''}} whose <!--
-->{{#ifeq:{{pagename}}|aetatu|'''}}lifespan{{#ifeq:{{pagename}}|aetatu|'''}} <!--
-->was {{#ifeq:{{pagename}}|oisa|'''}}used up{{#ifeq:{{pagename}}|oisa|'''}}. <!--
-->(He was) {{#ifeq:{{pagename}}|faber|'''}}forger{{#ifeq:{{pagename}}|faber|'''}} of <!--
-->{{#ifeq:{{pagename}}|solois|'''}}his own{{#ifeq:{{pagename}}|solois|'''}} <!--
-->{{#ifeq:{{pagename}}|des|'''}}fortune{{#ifeq:{{pagename}}|des|'''}} <!--
-->{{#ifeq:{{pagename}}|forte|'''}}his whole life{{#ifeq:{{pagename}}|forte|'''}} (?)
|textparam = -
}}<noinclude>{{documentation}}</noinclude>
